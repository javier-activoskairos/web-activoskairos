# Alta de leads en el CRM ([AK] - Contactos) vía n8n.
# Sólo servidor: NO llevan prefijo NEXT_PUBLIC_, no deben llegar al navegador.
N8N_LEAD_WEBHOOK_URL=https://n8n.activoskairos.com/webhook/web-lead-akairos
N8N_LEAD_KEY=

# Página de incorporación (/incorporacion): prellenado y envío del formulario
# que actualiza [AKC] - Empresas, [AKC] - Contactos y [AKC] - Seguimientos.
# Sólo servidor: la clave nunca llega al navegador.
N8N_INCORPORACION_PREFILL_URL=https://n8n.activoskairos.com/webhook/incorporacion-prefill
N8N_INCORPORACION_WEBHOOK_URL=https://n8n.activoskairos.com/webhook/incorporacion
N8N_INCORPORACION_KEY=

# Alta en la newsletter (KaiSend), formulario del pie de página.
# El navegador llama a /api/newsletter y es el servidor quien reenvía a n8n:
# por eso NO llevan NEXT_PUBLIC_, la URL y la clave no salen de aquí.
# La clave es opcional: si está definida se manda como cabecera x-ak-web-key.
# El webhook todavía no existe — este valor es de ejemplo y hay que sustituirlo
# por el real en EasyPanel antes de que el formulario dé de alta a nadie.
# Si falta la variable, /api/newsletter responde 500 y el formulario enseña un
# error controlado (además de avisar por consola); la web no se rompe.
N8N_KAISEND_ALTA_URL=https://n8n.activoskairos.com/webhook/kaisend-alta
N8N_KAISEND_ALTA_KEY=

# Sólo para desarrollo/preview. En producción la URL canónica está fijada en
# src/lib/site.ts y esta variable se ignora.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
