# Alta de leads en el CRM ([AK] - Contactos) vía n8n.
# Sólo servidor: NO llevan prefijo NEXT_PUBLIC_, no deben llegar al navegador.
N8N_LEAD_WEBHOOK_URL=https://n8n.activoskairos.com/webhook/web-lead-akairos
N8N_LEAD_KEY=

# Página de incorporación (/incorporacion): prellenado y envío del formulario
# que actualiza [AKC] - Empresas, [AKC] - Contactos y [AKC] - Seguimientos.
# Sólo servidor: la clave nunca llega al navegador.
N8N_INCORPORACION_PREFILL_URL=https://n8n.activoskairos.com/webhook/incorporacion-prefill
N8N_INCORPORACION_WEBHOOK_URL=https://n8n.activoskairos.com/webhook/incorporacion
N8N_INCORPORACION_KEY=

# Sólo para desarrollo/preview. En producción la URL canónica está fijada en
# src/lib/site.ts y esta variable se ignora.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
